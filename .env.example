# Copy to .env or export in your shell. With no key the app runs in
# DEMO mode on clearly-labelled mock data (see mock_data.py).

# Qloo Taste AI — hackathon key, requested via the form linked from
# https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
# Keys are issued manually ("a few business days") and are valid ONLY
# against the hackathon base URL below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

PORT=8000
